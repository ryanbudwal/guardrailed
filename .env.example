# Local-only defaults. Copy to .env; never commit the resulting file.
GATEWAY_ENVIRONMENT=development
GATEWAY_API_KEYS=local-development-key
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_PROVIDER=mock
GATEWAY_RATE_LIMIT_REQUESTS=20
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_CACHE_TTL_SECONDS=300
GATEWAY_MAX_PROMPT_CHARS=20000
GATEWAY_ALLOWED_TOPICS=
GATEWAY_PROVIDER_TIMEOUT_SECONDS=20
GATEWAY_ESTIMATED_COST_PER_1K_TOKENS=0

# Only needed after explicitly selecting GATEWAY_PROVIDER=openai:
# GATEWAY_OPENAI_API_KEY=
# GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
